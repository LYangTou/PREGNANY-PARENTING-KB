{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Registry",
  "type": "object",
  "required": ["groups", "sources"],
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "organization",
          "group",
          "domain",
          "evidenceLevel",
          "useFor",
          "url",
          "accessDate",
          "status"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "organization": { "type": "string" },
          "group": { "type": "string" },
          "domain": { "type": "string" },
          "evidenceLevel": { "type": "string" },
          "useFor": { "type": "array", "items": { "type": "string" } },
          "url": { "type": "string" },
          "accessDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "status": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
