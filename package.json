{
  "name": "pregnancy-parenting-kb",
  "version": "0.1.0",
  "private": true,
  "description": "家庭孕育知识库本地工具",
  "scripts": {
    "kb": "node scripts/run.js kb-workflow",
    "validate:sources": "node scripts/run.js validate-sources",
    "validate:cards": "node scripts/run.js validate-cards",
    "generate:md": "node scripts/run.js generate-card-md --all",
    "search": "node scripts/run.js search-cards",
    "review:card": "node scripts/run.js review-card",
    "web:dev": "next dev web --webpack -H 127.0.0.1 -p 8790",
    "web:build": "next build web --webpack",
    "web:start": "next start web -H 127.0.0.1 -p 8790"
  },
  "dependencies": {
    "@langchain/core": "^1.1.45",
    "@langchain/deepseek": "^1.0.25",
    "langchain": "^1.4.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
